{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sichter",
  "version": "0.1.0",
  "identifier": "de.heckerhere.sichter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sichter",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' thumb: http://thumb.localhost data: blob:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/exiftool/": "exiftool/"
    },
    "category": "Photography",
    "shortDescription": "Fotos und Videos sicher sortieren",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}